generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  accounts      Account[]
  sessions      Session[]
  connections   BankConnection[]
  categories    Category[]
  transactions  Transaction[]
  expenses      Expense[]
  incomes       Income[]
  investments   Investment[]
  investmentCashflows InvestmentCashflow[]
  fixedRules    FixedExpenseRule[]
  expenseOccurrences ExpenseOccurrence[]
  incomeOccurrences  IncomeOccurrence[]
  invoicePayments    InvoicePayment[]
  categoryBudgets    CategoryBudget[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model BankConnection {
  id             String        @id @default(cuid())
  userId         String
  provider       String
  externalItemId String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards          CreditCard[]

  @@unique([userId, provider, externalItemId])
  @@unique([id, userId])
  @@index([userId])
}

model CreditCard {
  id                String         @id @default(cuid())
  userId            String
  connectionId      String
  externalAccountId String
  name              String
  connection        BankConnection @relation(fields: [connectionId, userId], references: [id, userId], onDelete: Cascade)
  transactions      Transaction[]
  fixedRules        FixedExpenseRule[]
  closingDay        Int?
  dueDay            Int?
  creditLimitInCents BigInt?
  expenses          Expense[]
  invoicePayments   InvoicePayment[]

  @@unique([connectionId, externalAccountId])
  @@unique([id, userId])
  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  expenses     Expense[]
  budgets      CategoryBudget[]

  @@unique([userId, name])
  @@unique([id, userId])
}

model Transaction {
  id                    String     @id @default(cuid())
  userId                String
  cardId                String
  categoryId            String?
  providerTransactionId String
  description           String
  amountInCents         BigInt
  occurredAt            DateTime
  isFixed               Boolean    @default(false)
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card                  CreditCard @relation(fields: [cardId, userId], references: [id, userId], onDelete: Cascade)
  category              Category?  @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  linkedExpense         Expense?    @relation("LinkedManualExpense")

  @@unique([id, userId])
  @@unique([cardId, providerTransactionId])
  @@index([userId, occurredAt])
}

enum PaymentMethod {
    PIX
    CREDIT
    DEBIT
    AUTOMATIC_DEBIT
    OTHER
}

enum ExpenseType {
    FIXED
    VARIABLE
}

enum IncomeType {
    SALARY
    RECURRING
    OTHER
}

model Expense {
    id            String        @id @default(cuid())
    userId        String
    description   String
    amountInCents BigInt
    paymentMethod PaymentMethod
    type          ExpenseType
    date          DateTime?     @db.Date
    installments  Int           @default(1)
    cardId        String?
    categoryId    String?
    category      Category?     @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
    linkedTransactionId String?
    card          CreditCard?   @relation(fields: [cardId, userId], references: [id, userId], onDelete: Restrict)
    linkedTransaction Transaction? @relation("LinkedManualExpense", fields: [linkedTransactionId, userId], references: [id, userId], onDelete: Restrict)
    endsOn        DateTime?     @db.Date
    createdAt     DateTime      @default(now())
    user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    occurrences   ExpenseOccurrence[]

    @@unique([id, userId])
    @@unique([linkedTransactionId, userId])
    @@index([userId, createdAt])
}

model Income {
    id            String      @id @default(cuid())
    userId        String
    amountInCents BigInt
    type          IncomeType
    responsible   String?
    description   String?
    date          DateTime?   @db.Date
    endsOn        DateTime?   @db.Date
    archivedAt    DateTime?
    createdAt     DateTime    @default(now())
    user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    occurrences   IncomeOccurrence[]

    @@unique([id, userId])
    @@index([userId, createdAt])
}

model Investment {
    id        String               @id @default(cuid())
    userId    String
    name      String
    createdAt DateTime             @default(now())
    user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    snapshots InvestmentSnapshot[]
    cashflows InvestmentCashflow[]

    @@unique([id, userId])
    @@index([userId])
}

model InvestmentSnapshot {
    id            String     @id @default(cuid())
    investmentId  String
    userId        String
    amountInCents BigInt
    recordedAt    DateTime   @db.Date
    createdAt     DateTime   @default(now())
    investment    Investment @relation(fields: [investmentId, userId], references: [id, userId], onDelete: Cascade)

    @@index([investmentId, recordedAt, createdAt])
    @@index([userId])
}

model FixedExpenseRule {
    id          String     @id @default(cuid())
    userId      String
    cardId      String
    merchantKey String
    createdAt   DateTime   @default(now())
    user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    card        CreditCard @relation(fields: [cardId, userId], references: [id, userId], onDelete: Cascade)

    @@unique([userId, cardId, merchantKey])
    @@index([userId])
}

enum OccurrenceStatus {
    PENDING
    SETTLED
    CANCELED
}

model ExpenseOccurrence {
    id                  String           @id @default(cuid())
    userId              String
    expenseId           String
    dueMonth            DateTime         @db.Date
    status              OccurrenceStatus @default(PENDING)
    actualAmountInCents BigInt?
    settledAt           DateTime?
    updatedAt           DateTime         @updatedAt
    user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    expense             Expense          @relation(fields: [expenseId, userId], references: [id, userId], onDelete: Cascade)

    @@unique([expenseId, dueMonth])
    @@index([userId, dueMonth])
}

model IncomeOccurrence {
    id                  String           @id @default(cuid())
    userId              String
    incomeId            String
    dueMonth            DateTime         @db.Date
    status              OccurrenceStatus @default(PENDING)
    actualAmountInCents BigInt?
    settledAt           DateTime?
    updatedAt           DateTime         @updatedAt
    user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    income              Income           @relation(fields: [incomeId, userId], references: [id, userId], onDelete: Cascade)

    @@unique([incomeId, dueMonth])
    @@index([userId, dueMonth])
}

model InvoicePayment {
    id              String     @id @default(cuid())
    userId          String
    cardId          String
    period          String
    idempotencyKey  String
    amountInCents   BigInt
    paidAt          DateTime   @db.Date
    createdAt       DateTime   @default(now())
    user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    card            CreditCard @relation(fields: [cardId, userId], references: [id, userId], onDelete: Restrict)

    @@unique([userId, cardId, idempotencyKey])
    @@index([userId, cardId, period])
}

model CategoryBudget {
    id              String   @id @default(cuid())
    userId          String
    categoryId      String
    period          String
    limitInCents    BigInt
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    category        Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)

    @@unique([userId, categoryId, period])
    @@index([userId, period])
}

enum InvestmentCashflowType {
    DEPOSIT
    WITHDRAWAL
}

model InvestmentCashflow {
    id              String                 @id @default(cuid())
    investmentId    String
    userId          String
    type            InvestmentCashflowType
    amountInCents   BigInt
    occurredAt      DateTime               @db.Date
    createdAt       DateTime               @default(now())
    investment      Investment             @relation(fields: [investmentId, userId], references: [id, userId], onDelete: Cascade)
    user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([investmentId, occurredAt, createdAt])
    @@index([userId, occurredAt])
}
